{
  "name": "uat-batch2",
  "viewport": {
    "width": 412,
    "height": 915
  },
  "steps": [
    {
      "action": "goto",
      "path": "/music/play/"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "waitFor",
      "selector": "#segJams",
      "timeoutMs": 8000
    },
    {
      "action": "tap",
      "selector": "#segJams"
    },
    {
      "action": "wait",
      "ms": 400
    },
    {
      "action": "evalAssert",
      "label": "UAT-3: the Jams view lists ONLY playable rows (every row carries data-npkey), and is non-empty",
      "js": "(function(){var rows=document.querySelectorAll('#songsList .listItem');if(!rows.length)return false;for(var i=0;i<rows.length;i++){if(!rows[i].hasAttribute('data-npkey'))return false;}return true;})()"
    },
    {
      "action": "evalAssert",
      "label": "UAT-3b: Jams is a strict subset - the All view has rows Jams excludes (the filter really filters)",
      "js": "(function(){var jams=document.querySelectorAll('#songsList .listItem').length;document.getElementById('segAll').click();var all=document.querySelectorAll('#songsList .listItem').length;document.getElementById('segJams').click();return all>jams&&jams>0;})()"
    },
    {
      "action": "screenshot",
      "name": "jams-view"
    },
    {
      "action": "waitFor",
      "selector": "[data-npkey='reggae backing track in a major|petti music studios|A|major']",
      "timeoutMs": 8000
    },
    {
      "action": "tap",
      "selector": "[data-npkey='reggae backing track in a major|petti music studios|A|major'] .li-body"
    },
    {
      "action": "waitFor",
      "selector": ".bt-player.mini .bt-st-head",
      "timeoutMs": 6000
    },
    {
      "action": "tap",
      "selector": "[data-npkey='reggae backing track in a major|petti music studios|A|major'] .li-lead"
    },
    {
      "action": "waitFor",
      "selector": ".bt-player.studio:not(.mini) .bt-st-body",
      "timeoutMs": 6000
    },
    {
      "action": "tap",
      "selector": ".bt-player .bt-st-t"
    },
    {
      "action": "wait",
      "ms": 350
    },
    {
      "action": "tapIfVisible",
      "text": "Keep open"
    },
    {
      "action": "evalAssert",
      "label": "UAT-5/v5: bar in its ONE slot above the tabbar; the sheet is OPAQUE behind it (no rows leak through the band); tabs painted above the sheet",
      "js": "(function(){var h=document.querySelector('.bt-player.studio .bt-st-head');var tab=document.querySelector('.tabbar');if(!h||!tab)return false;var r=h.getBoundingClientRect(),tr=tab.getBoundingClientRect();if(!(r.bottom<=tr.top+1))return false;var band=document.elementFromPoint(window.innerWidth/2, r.top-4);if(!band||!band.closest('.bt-player'))return false;var tc=document.elementFromPoint(tr.left+tr.width/2, tr.top+tr.height/2);return !!tc&&!!tc.closest('.tabbar');})()"
    },
    {
      "action": "evalAssert",
      "label": "UAT-4/v7 (round 11): video expanded -> the bar keeps its ONE constant shape - pp AND progress stay visible, NO bar video CTA exists in any state, and the theater card carries its own minimize handle",
      "js": "(function(){if(document.querySelector('[data-vidmin]'))return false;var pp=document.querySelector('.bt-player [data-nppp]');var pr=document.querySelector('.bt-player [data-npprog]');if(!pp||pp.offsetParent===null||!pr||pr.offsetParent===null)return false;var h=document.querySelector('[data-thmin]');return !!h&&h.getBoundingClientRect().height>0;})()"
    },
    {
      "action": "screenshot",
      "name": "expanded-bottom-bar"
    },
    {
      "action": "tap",
      "selector": "[data-stmenu]"
    },
    {
      "action": "evalAssert",
      "label": "v3: the hamburger fly-out anchors under the sheet's TOPBAR and drops down over the media",
      "js": "(function(){var p=document.querySelector('[data-stmenu-panel]');var tb=document.querySelector('.bt-st-topbar');if(!p||p.hidden||!tb)return false;var pr=p.getBoundingClientRect(),tr=tb.getBoundingClientRect();return pr.top>=tr.bottom-2&&pr.height>40;})()"
    },
    {
      "action": "tap",
      "selector": "[data-stmenu]"
    },
    {
      "action": "tap",
      "selector": "[data-thmin]"
    },
    {
      "action": "evalAssert",
      "label": "UAT-4b (round 15): the card's handle DISMISSES to parked - no intermediate docked step - pp+progress still visible (constant bar), the handle gone with the theater",
      "js": "(function(){var m=document.querySelector('[data-media]');var pp=document.querySelector('.bt-player [data-nppp]');var h=document.querySelector('[data-thmin]');return !!m&&m.classList.contains('hid')&&!!pp&&pp.offsetParent!==null&&!!h&&h.getBoundingClientRect().height===0;})()"
    },
    {
      "action": "screenshot",
      "name": "audio-only-bottom-bar"
    },
    {
      "action": "tap",
      "selector": ".bt-st-back"
    },
    {
      "action": "waitFor",
      "selector": ".bt-player.mini .bt-st-head",
      "timeoutMs": 6000
    },
    {
      "action": "assertVisible",
      "selector": ".bt-player.mini [data-nppp]"
    },
    {
      "action": "resize",
      "width": 915,
      "height": 412
    },
    {
      "action": "tap",
      "selector": "[data-npkey='reggae backing track in a major|petti music studios|A|major'] .li-lead"
    },
    {
      "action": "waitFor",
      "selector": ".bt-player.studio:not(.mini) .bt-st-body",
      "timeoutMs": 6000
    },
    {
      "action": "evalAssert",
      "label": "landscape: the bar keeps its ONE slot above the tabbar (centered 540 card, sheet above it)",
      "js": "(function(){var h=document.querySelector('.bt-player.studio .bt-st-head');var tab=document.querySelector('.tabbar');if(!h||!tab)return false;var r=h.getBoundingClientRect(),tr=tab.getBoundingClientRect();return r.bottom<=tr.top+1&&r.height>=44&&r.width<=542;})()"
    },
    {
      "action": "screenshot",
      "name": "landscape-bottom-bar"
    },
    {
      "action": "tap",
      "selector": ".bt-st-back"
    },
    {
      "action": "waitFor",
      "selector": ".bt-player.mini .bt-st-head",
      "timeoutMs": 6000
    },
    {
      "action": "tap",
      "selector": ".bt-player.mini [data-minix]"
    },
    {
      "action": "waitFor",
      "selector": ".bt-player .bt-st-head",
      "state": "hidden",
      "timeoutMs": 6000
    },
    {
      "action": "evalAssert",
      "label": "teardown clears every player class including vidopen",
      "js": "(function(){var p=document.querySelector('.bt-player');return !p.classList.contains('on')&&!p.classList.contains('vidopen')&&p.innerHTML==='';})()"
    }
  ]
}
