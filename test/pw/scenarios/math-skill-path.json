  "steps": [
    {
      "action": "evalAssert",
      "label": "on first load the Skills home shows no Custom Start bar (one primary: Race)",
      "js": "getComputedStyle(document.getElementById('startBar')).display==='none'&&document.querySelector('.tabbar button.on').getAttribute('data-tab')==='path'"
    },
    {
      "action": "evalAssert",
      "label": "25 add-10 facts seeded solid -> path shows it mastered, band line counts it",
      "js": "/Ava: Beginner, 1 of 12 skills mastered/.test(document.getElementById('bandLine').textContent)&&document.querySelectorAll('#pathList [data-skill=\"add-10\"] .mStars .on').length===3"
    },
    {
      "action": "evalAssert",
      "label": "Subtraction from 10 is up next",
      "js": "document.querySelector('#nextCard .mNextName').textContent==='Subtraction from 10'&&/Up next/i.test(document.querySelector('#nextCard .mNextTag').textContent)"
    },
    {
      "action": "screenshot",
      "name": "math-skill-path"
    },
    {
      "action": "evalAssert",
      "label": "stub navigator.vibrate",
      "js": "(function(){window.__buzz=[];navigator.vibrate=function(p){window.__buzz.push(JSON.stringify(p));return true;};return true;})()"
    },
    {
      "action": "tap",
      "selector": "#nextCard [data-go=\"race\"]"
    },
    {
      "action": "evalAssert",
      "label": "the skill race is 10 subtraction facts from 10 (beginner length)",
      "js": "(function(){var t=document.getElementById('problem').textContent;return /^\\d+ \\u2212 \\d+$/.test(t)&&document.getElementById('runCount').textContent==='1 of 10';})()"
    },
    {
      "action": "evalAssert",
      "label": "answer all 10 right (waiting out each green hold)",
      "js": "(async function(){function ans(){var t=document.getElementById('problem').textContent.split(' ');var a=+t[0],b=+t[2],o=t[1];return o==='+'?a+b:(o==='\\u2212'?a-b:(o==='\\u00d7'?a*b:a/b));}function type(n){String(n).split('').forEach(function(d){document.querySelector('#keypad [data-k=\"'+d+'\"]').click();});}function sleep(ms){return new Promise(function(r){setTimeout(r,ms);});}var n=0;while(!document.getElementById('runLayer').hidden&&n<30){type(ans());n++;await sleep(330);}return n===10;})()"
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "evalAssert",
      "label": "level-up moment: Addition to 10 mastered, level haptic, next skill offered",
      "js": "!document.getElementById('lvlLayer').hidden&&document.getElementById('lvlName').textContent==='Addition to 10'&&window.__buzz.indexOf('[60,40,60,40,160]')>=0&&document.getElementById('lvlGo').textContent==='Start Subtraction from 10'"
    },
    {
      "action": "screenshot",
      "name": "math-level-up"
    },
    {
      "action": "tap",
      "selector": "#lvlDone"
    },
    {
      "action": "evalAssert",
      "label": "results underneath list the star gain",
      "js": "document.getElementById('lvlLayer').hidden&&!document.getElementById('resLayer').hidden&&/Addition to 10/.test(document.getElementById('resStars').textContent)"
    },
    {
      "action": "evalAssert",
      "label": "earned stars persisted with a mastered date",
      "js": "(function(){var e=JSON.parse(localStorage.getItem('math.skills.pAva.v1'));return e['add-10'].stars===3&&typeof e['add-10'].masteredAt==='number';})()"
    },
    {
      "action": "tap",
      "selector": "#doneBtn"
    },
    {
      "action": "wait",
      "ms": 250
    },
    {
      "action": "tap",
      "selector": "#pathList [data-skill=\"x-2-5-10\"]"
    },
    {
      "action": "evalAssert",
      "label": "all open: tapping a later skill focuses it",
      "js": "document.querySelector('#nextCard .mNextName').textContent==='Times 2, 5 and 10'&&/Practising/i.test(document.querySelector('#nextCard .mNextTag').textContent)"
    },
    {
      "action": "tap",
      "selector": ".tabbar [data-tab=\"progress\"]"
    },
