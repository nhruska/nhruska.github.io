{
  "name": "setlist-drag-reorder",
  "persona": "intermediate",
  "dismissNotables": [
    "composeintro",
    "transposetip",
    "pulljam",
    "backup"
  ],
  "seed": {
    "roadcase-ukulele-gcea.setlist.v1": "[\"k0\",\"k1\",\"k2\"]"
  },
  "note": "Setlist rows are ALWAYS reorderable (grip drag) and removable - there is no edit mode. REWRITTEN 2026-07-26 (SONGS-MERGE phase 1): this scenario asserted the RETIRED edit-mode contract (#setEdit revealing up/dn arrows, a body-tap that must NOT open while arranging). #setEdit has not existed for some time, so the scenario was failing on main and guarding nothing - a dead guard on the setlist, found while merging Library+Setlist. It now asserts today's contract: drag from the grip reorders and persists, and a body tap always opens the song.",
  "viewport": {
    "width": 412,
    "height": 915
  },
  "steps": [
    {
      "action": "tap",
      "selector": ".tabbar [data-tab=\"library\"]"
    },
    {
      "action": "tap",
      "selector": "#segSet"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "evalAssert",
      "label": "the seeded 3-song set is up",
      "js": "(function(){return document.querySelectorAll('#setBody .listItem').length===3;})()"
    },
    {
      "action": "evalAssert",
      "label": "today's contract: every row carries a grip, and there is no edit-mode toggle to enter",
      "js": "(function(){var rows=document.querySelectorAll('#setBody .listItem');if(rows.length!==3)return false;var grips=document.querySelectorAll('#setBody .li-grip');return grips.length===3 && !document.getElementById('setEdit');})()"
    },
    {
      "action": "evalAssert",
      "label": "prep the drag: scroll the set into view, clear any stray text selection",
      "js": "(function(){var r=document.querySelector('#setBody .listItem');if(!r)return false;r.scrollIntoView({block:'center'});try{window.getSelection().removeAllRanges();}catch(e){}return true;})()"
    },
    {
      "action": "dragReorder",
      "from": "#setBody .listItem:nth-child(1) .li-grip",
      "to": "#setBody .listItem:nth-child(3)",
      "side": "below"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "evalAssert",
      "label": "RED GOALPOST: row 1 dragged below row 3 - the setlist PERSISTS as k1,k2,k0 (order is the content here, so it has to survive the write)",
      "js": "(function(){var s=JSON.parse(localStorage.getItem('roadcase-ukulele-gcea.setlist.v1')||'[]');return JSON.stringify(s)===JSON.stringify(['k1','k2','k0']);})()"
    },
    {
      "action": "evalAssert",
      "label": "the visible position numbers follow the new order (1,2,3 top to bottom, not a stale render)",
      "js": "(function(){var n=Array.prototype.map.call(document.querySelectorAll('#setBody .listItem .li-num'),function(e){return e.textContent.trim();});return JSON.stringify(n)===JSON.stringify(['1','2','3']);})()"
    },
    {
      "action": "screenshot",
      "name": "setlist-drag-reordered"
    },
    {
      "action": "evalAssert",
      "label": "prep the drag: scroll the set into view, clear any stray text selection",
      "js": "(function(){var r=document.querySelector('#setBody .listItem');if(!r)return false;r.scrollIntoView({block:'center'});try{window.getSelection().removeAllRanges();}catch(e){}return true;})()"
    },
    {
      "action": "dragReorder",
      "from": "#setBody .listItem:nth-child(3) .li-grip",
      "to": "#setBody .listItem:nth-child(1)",
      "side": "above"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "evalAssert",
      "label": "dragging the last row back above the first restores k0,k1,k2",
      "js": "(function(){var s=JSON.parse(localStorage.getItem('roadcase-ukulele-gcea.setlist.v1')||'[]');return JSON.stringify(s)===JSON.stringify(['k0','k1','k2']);})()"
    },
    {
      "action": "tap",
      "selector": "#setBody .listItem:nth-child(1) .li-body"
    },
    {
      "action": "wait",
      "ms": 600
    },
    {
      "action": "evalAssert",
      "label": "a body tap ALWAYS opens the song now - there is no arrange-only mode in which it must not",
      "js": "(function(){var p=document.getElementById('s-practice');return !!p && p.classList.contains('on');})()"
    },
    {
      "action": "screenshot",
      "name": "setlist-drag-body-tap-opens"
    }
  ]
}