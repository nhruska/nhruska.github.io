{
  "name": "solo-skip-mixolydian",
  "description": "MERGE GATE for the progression-aware picker + FORK-4 removal: in an explicitly STATED C major (a picked key - the D-KEY-FOLLOW defaulted C would re-infer C-F-Bb as F major V-I-IV, #281), build C-F-Bb (I-IV-bVII; the palette spells the bVII by role as Bb since #199), Solo -> Skip; the Studio must default to Mixolydian with Mixolydian+Dorian chips present and the b7 spelled KEY-AWARE as Bb (never A#) in the notes line.",
  "url": "/music/play/",
  "steps": [
    {
      "action": "tap",
      "selector": ".tabbar button[data-tab=compose]"
    },
    {
      "action": "waitFor",
      "selector": "#catChips .chordSegBtn"
    },
    {
      "action": "tapIfVisible",
      "text": "I know some chords",
      "scope": "#guidanceAskSlot"
    },
    {
      "action": "tap",
      "selector": "#keyPickerCompact"
    },
    {
      "action": "waitFor",
      "selector": "#keyRoots"
    },
    {
      "action": "tapText",
      "text": "C",
      "scope": "#keyRoots"
    },
    {
      "action": "tapText",
      "text": "C",
      "scope": "#keyRoots"
    },
    {
      "action": "tap",
      "selector": "#keyPickerCompact"
    },
    {
      "action": "waitFor",
      "selector": ".composeWrap.keyOpen",
      "state": "hidden"
    },
    {
      "action": "tapText",
      "text": "All",
      "scope": "#catChips"
    },
    {
      "action": "wait",
      "ms": 250
    },
    {
      "action": "tapChord",
      "name": "C"
    },
    {
      "action": "tapChord",
      "name": "F"
    },
    {
      "action": "tapChord",
      "name": "Bb"
    },
    {
      "action": "evalAssert",
      "label": "the STATED key holds: C F Bb stays in C Maj (I IV bVII), not re-inferred to F (V I IV)",
      "js": "(function(){var c=document.getElementById('keyPickerCompact');return !!c && /C\\s*Maj/i.test(c.textContent);})()"
    },
    {
      "action": "waitFor",
      "selector": "#soloBackingBtn"
    },
    {
      "action": "screenshot",
      "name": "progression-built"
    },
    {
      "action": "tap",
      "selector": "#soloBackingBtn"
    },
    {
      "action": "waitFor",
      "selector": ".composeRow.asModal"
    },
    {
      "action": "tapText",
      "text": "Just practice",
      "scope": ".composeRow"
    },
    {
      "action": "waitFor",
      "selector": "[data-scalechips]"
    },
    {
      "action": "assertChipOn",
      "selector": "[data-scalechips] .bt-st-scalechip",
      "text": "Mixolydian"
    },
    {
      "action": "assertCount",
      "selector": "[data-scalechips] .bt-st-scalechip",
      "min": 5
    },
    {
      "action": "assertText",
      "selector": ".bt-st-notes",
      "contains": "Bb"
    },
    {
      "action": "screenshot",
      "name": "studio-mixolydian-default"
    }
  ]
}
