{
  "name": "jam-starter",
  "description": "G4 S-JAM-STARTER: build a plain diatonic C major progression (C-F-G), Solo -> Just practice lands the fresh no-video Studio - it must show ONE tappable curated starter chip (.bt-jam-starter) labeled with the resolved candidate's genre + the current key, so a beginner reaches a playing jam in one tap instead of navigating the Find-a-jam genre/feel finder.",
  "url": "/music/play/",
  "steps": [
    {
      "action": "tap",
      "selector": ".tabbar button[data-tab=compose]"
    },
    {
      "action": "waitFor",
      "selector": "#catChips .chordSegBtn"
    },
    {
      "action": "tapIfVisible",
      "text": "I know some chords",
      "scope": "#guidanceAskSlot"
    },
    {
      "action": "tapText",
      "text": "All",
      "scope": "#catChips"
    },
    {
      "action": "wait",
      "ms": 250
    },
    {
      "action": "tapChord",
      "name": "C"
    },
    {
      "action": "tapChord",
      "name": "F"
    },
    {
      "action": "tapChord",
      "name": "G"
    },
    {
      "action": "waitFor",
      "selector": "#soloBackingBtn"
    },
    {
      "action": "tap",
      "selector": "#soloBackingBtn"
    },
    {
      "action": "waitFor",
      "selector": ".composeRow.asModal"
    },
    {
      "action": "tapText",
      "text": "Just practice",
      "scope": ".composeRow"
    },
    {
      "action": "waitFor",
      "selector": "[data-scalechips]"
    },
    {
      "action": "assertVisible",
      "selector": ".bt-jam-starter"
    },
    {
      "action": "evalAssert",
      "js": "/^Play a (\\S.* )?jam in \\S+/.test(document.querySelector('.bt-jam-starter').textContent.trim())",
      "label": "starter label matches the SHAPE 'Play a [genre ]jam in <key>' - never pinned to the catalog's current first candidate (content-pinned rot)"
    },
    {
      "action": "evalAssert",
      "js": "document.querySelector('.bt-jam-starter').textContent.indexOf(' in C') > -1",
      "label": "starter key matches the progression's C-major context (candidate's own key label)"
    },
    {
      "action": "screenshot",
      "name": "studio-jam-starter"
    }
  ]
}
